DATABASE_URL="file:./dev.db"

# Só usado pela sugestão de corte de gastos em /resumo/ia e /cofre
# (Claude, via API paga — console.anthropic.com, NÃO é o mesmo que uma
# assinatura Pro/Max do claude.ai). Sem isso, o botão aparece na tela
# mas falha com uma mensagem clara, nunca quebra a página. Use uma
# chave própria por ambiente (local ≠ VPS) — nunca compartilhar, pra
# teste local nunca competir com uso real de custo/limite.
ANTHROPIC_API_KEY=

# ── Login único pelo Hub (OIDC) ─────────────────────────────────────────
# O sistema inteiro é privado: sem estas variáveis ele fica FECHADO
# ("Acesso não configurado"). Valores do bloco "Login único" do sistema
# no Hub (Sistemas › Gestor Financeiro). Ver ROADMAP, "Login único pelo Hub".
APP_URL=https://gestor.ifatokun.com.br
HUB_ISSUER=https://hub.ifatokun.com.br/oidc
HUB_CLIENT_ID=
HUB_CLIENT_SECRET=
# Opcionais (padrões entre parênteses):
# HUB_SSO_ENABLED=true                    (false = desliga o SSO)
# HUB_SCOPES="openid email profile"
# HUB_TOKEN_AUTH_METHOD=client_secret_basic   (ou client_secret_post, igual ao bloco no Hub)
# HUB_PAPEIS_PERMITIDOS=admin             (papéis do Hub aceitos, separados por vírgula; vazio = qualquer)
# GESTOR_SESSAO_HORAS=12                  (duração da sessão local; o Hub reabre sozinho depois)

# Plano B (desligado por padrão): senha + código do app autenticador, só
# para o dono, só com o SSO desligado ou o Hub fora do ar. Gerar com
#   npm run auth:emergencia -- --senha 'senha longa'
# GESTOR_LOGIN_EMERGENCIA=false
# GESTOR_EMERGENCIA_SENHA_HASH=
# GESTOR_EMERGENCIA_TOTP=

# Só em desenvolvimento local (ignorado em produção): abre o sistema sem login.
# GESTOR_AUTH_DESLIGADA=true
